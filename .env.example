# Rename this file to .env and fill in your keys.
# Only variables with the EXPO_PUBLIC_ prefix are inlined into the JS bundle.
#
# The model the app calls (see README §2). Tested providers below —
# Gemini worked; use whichever vision-capable provider your key covers.

GEMINI_API_KEY=your_gemini_api_key
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# Spare keys kept for potential fallback models (unused by the app)
MISTRAL_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
