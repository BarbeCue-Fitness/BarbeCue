{
  "expo": {
    "name": "BarbeCue",
    "slug": "BarbeCue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "barbecue",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.barbecue.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "server",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/branding/adaptive-monochrome.png",
          "imageWidth": 144
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "BarbeCue uses your photos to scan a meal.",
          "cameraPermission": "BarbeCue uses the camera to scan a meal.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "BarbeCue uses your location to find gym partners nearby."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee169575-147c-420a-9dde-71f29742c865"
      }
    },
    "owner": "crustin"
  }
}
